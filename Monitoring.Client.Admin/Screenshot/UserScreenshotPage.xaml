<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:local="clr-namespace:Monitoring.Client.Admin"
    x:Class="Monitoring.Client.Admin.UserScreenshotPage"
    x:DataType="local:UserScreenshotViewModel">

    <Grid
        Padding="50"
        RowSpacing="10"
        RowDefinitions="Auto,*"
        VerticalOptions="Center"
        HorizontalOptions="Center">

        <Label
            Grid.Row="0"
            VerticalTextAlignment="Center"
            Text="{Binding RequestId, StringFormat='Request Id: {0}'}" />

        <Image
            Grid.Row="1"
            Source="{Binding Image}" />
    </Grid>
</ContentPage>